# In den http{}-Block:
limit_req_zone $binary_remote_addr zone=certapi:10m rate=10r/s;

server {
    listen 443 ssl;
    http2 on;
    server_name certs.example.com;

    ssl_certificate     /etc/letsencrypt/live/certs.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/certs.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # API-Keys und Private Keys nicht ins Access-Log schreiben
    access_log /var/log/nginx/cert-api.access.log;

    location / {
        limit_req zone=certapi burst=20 nodelay;

        proxy_pass http://127.0.0.1:8443;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
    }
}
